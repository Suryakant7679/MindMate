# Existing model authentication (optional for already-cached weights)
HF_TOKEN=

# LangGraph/MCP feature switch. Direct Llama/Sarvam chat remains available when false.
MCP_ENABLED=false
LANGGRAPH_CHECKPOINT_PATH=chatbot_feature/data/checkpoints.sqlite

# API-backed MCP servers
BRAVE_API_KEY=
FIRECRAWL_API_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=
CONTEXT7_API_KEY=

# Filesystem, Git, and durable knowledge-graph boundaries
MCP_FILESYSTEM_ROOT=/absolute/path/to/approved/files
MCP_GIT_REPOSITORY_ROOT=/absolute/path/to/approved/repository
MCP_MEMORY_FILE_PATH=/absolute/path/to/private/mindmate-memory.jsonl

DEFAULT_TIMEZONE=Asia/Kolkata
MCP_CONNECT_TIMEOUT_SECONDS=30
MCP_TOOL_TIMEOUT_SECONDS=60
MCP_MAX_CONCURRENT_TOOL_CALLS=5
